# Exemple des variables lues par Docker Compose (F-008). `pnpm -w pile preparer` (F-031) copie ce
# fichier en infra/.env, ignoré par git et en mode 600, commentaires compris, et y écrit un
# POSTGRES_PASSWORD tiré au hasard (24 octets, 48 caractères hexadécimaux) ; il ne modifie jamais un
# infra/.env déjà présent. Prérequis du poste : Docker avec Compose 2.24.0 ou plus récent ; curl et
# trivy pour la fumée (pnpm -w fumee).
#
# Le mot de passe entre dans une URL de connexion : seulement les caractères A-Z a-z 0-9 - . _ ~, qui
# n'y ont pas besoin d'être encodés (`pnpm -w pile demarrer` refuse les autres). PostgreSQL ne le lit
# que sur un volume vide : le changer après le premier démarrage fait refuser la connexion à la
# migration et au serveur ; `pnpm -w pile accorder` donne alors au volume le mot de passe de ce fichier.

# Mot de passe factice, à remplacer (preparer le remplace).
POSTGRES_PASSWORD=factice-a-remplacer

# Facultatif : port du poste (toujours sur 127.0.0.1) où la base et le serveur sont publiés.
# Qui change le premier change aussi le port de l'URL d'apps/server/.env (mode hôte) ; qui change le
# second règle aussi NOTIONLIKE_RELAIS_API pour le relais de Vite.
# PORT_PUBLIE_BASE=5432
# PORT_PUBLIE_SERVEUR=3000
