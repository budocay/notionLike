# .agents/outils.env — généré depuis la fiche (.agents/fiche.yaml, outillage_qualite). Fichier protégé, seule
# source de configuration du socle. Convention : le contrôle NOM exécute NOM_CMD.
HARNESS="claude-code"
CRITICITE="interne"
BRANCHE_PRINCIPALE="main"
CODEOWNER=""                                          # vide : pas de plateforme, donc pas de CODEOWNERS (D-001)
TEST_CMD="pnpm exec vitest run --passWithNoTests"
TEST_SETUP_CMD="pnpm install --frozen-lockfile --prefer-offline"   # dans le worktree du pre-push
FORMAT_CHECK_CMD="pnpm exec prettier --check --ignore-unknown"
LINT_CMD="pnpm exec eslint --no-warn-ignored"
LINT_EXT="ts tsx js jsx mjs cjs"                       # FORMAT_EXT vide : le formateur voit tous les fichiers
SECRETS_STDIN_CMD="gitleaks stdin --no-banner --no-color --redact -v --ignore-gitleaks-allow"
SECRETS_PLAGE_CMD="gitleaks git --no-banner --no-color --redact -v --ignore-gitleaks-allow --log-opts"
TESTS_GLOB="**/*.test.* **/*.spec.* **/test/** **/e2e/**"
DEPS_AGE_MIN_JOURS=7
DEPS_APPROUVEES=""
CONTROLES_SUPPL="SAST SCA CONTRATS CONTENEURS"
CONTROLES_SECURITE="SAST SCA CONTENEURS"
SAST_CMD="semgrep scan --config .semgrep.yml --error --disable-nosem --metrics=off"   # « nosemgrep » ignoré
SCA_CMD="pnpm audit --audit-level high"
CONTRATS_CMD="pnpm exec depcruise --config .dependency-cruiser.cjs apps packages"
CONTENEURS_CMD="trivy fs --exit-code 1 --severity HIGH,CRITICAL ."
ACCEPTE_UNVERIFIED=""                                 # contrôles UNVERIFIED acceptés par le dev (dette D-xxx)
ACCEPTE_UNVERIFIED_LOCAL=""                           # idem, hors CI seulement
GATES_STANDARD="agent-architecte agent-securite agent-craft"      # + reviewers de la ligne « Revue : »
GATES_STRUCTUREL="agent-architecte agent-securite agent-craft"
GATE_CMD="claude -p --setting-sources project"   # route A ; sans la config perso du poste (plugins, CLAUDE.md global)
GATE_CRITIQUE_CMD=""
GATE_CRITIQUE_AGENTS=""
PARTAGE_EXTERNE_AUTORISE="non"
