# Exemple de configuration du serveur (F-008). Copier ce fichier en apps/server/.env,
# ignoré par git, puis y mettre le vrai mot de passe de la base. Le serveur ne lit
# aucun fichier : ces variables lui parviennent par son environnement.

# development, test ou production.
NODE_ENV=development

# Adresse et port d'écoute.
HOTE=127.0.0.1
PORT=3000

# Mot de passe factice, à remplacer : en production, le serveur refuse de démarrer avec lui.
URL_BASE_DONNEES=postgres://notionlike:factice-a-remplacer@127.0.0.1:5432/notionlike

# Origines autorisées, séparées par des virgules ; vide : aucune origine n'est autorisée.
ORIGINES_AUTORISEES=
